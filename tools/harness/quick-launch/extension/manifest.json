{
  "manifest_version": 3,
  "name": "EINK Harness",
  "version": "0.1.0",
  "description": "Quick launch and lifecycle controls for the local EINK Harness.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["http://127.0.0.1:5175/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "EINK Harness",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
